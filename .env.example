# ================================================================
# SoleCare — Muhit o'zgaruvchilari
# ================================================================
# Bu faylni nusxalab ".env" nomi bilan saqlang:
#   cp .env.example .env
# Keyin qiymatlarni Supabase Dashboard dan oling.
# ================================================================

# -----------------------------------------------------------
# FRONTEND (Vite) — bu ikki qiymat MAJBURIY
# Supabase Dashboard → Settings → API dan oling
# -----------------------------------------------------------
VITE_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------
# TELEGRAM BOT — bot/ papkasida .env ga ham qo'shing
# -----------------------------------------------------------
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------
# SEED SCRIPT — seed.mjs uchun kerak
# Supabase Dashboard → Settings → API → service_role (secret)
# -----------------------------------------------------------
SUPABASE_URL=https://XXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Super Admin hisobi (seed.mjs yaratadi)
SUPER_ADMIN_EMAIL=superadmin@solecare.uz
SUPER_ADMIN_PASSWORD=Admin123456!
