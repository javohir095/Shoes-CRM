# Supabase (service_role — faqat server tarafda ishlatiladi)
SUPABASE_URL=https://XXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram bot token (@BotFather dan olinadi)
# Eslatma: Agar multi-tenant bo'lsa, tokenlar Supabase companies jadvalida saqlanadi
# Bu token fallback yoki test uchun
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
